# Copy to the repository root as .env (gitignored). The script loads it automatically.

# HF fine-grained token: "Make calls to Inference Endpoints" (embedding) and
# "Manage Inference Endpoints" (resume/pause and the cost meter, plan §3.1).
HF_TOKEN=

# Endpoint URLs (optional when endpoint_name is set in models.yaml: read from the endpoint API).
ENDPOINT_URL_JUA_4B_MIXED=
ENDPOINT_URL_QWEN3_EMB_4B=
ENDPOINT_URL_INF_RETRIEVER_V1=

# Planned providers (not implemented yet).
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
GEMINI_API_KEY=
