e), Paragraph(“Seção IV Da Liberação de Certidão Negativa de Débito sem Prova de Contabilidade Regular, fechasAspas = false), Paragraph(Art. 386. .…............................................................................”, fechasAspas = false), Paragraph(“Seção V Das Demais Disposições, fechasAspas = false), Paragraph(Art. 387. .................................................................................”, fechasAspas = false), Paragraph(Art. 4º Esta Instrução Normativa entra em vigor na data de sua publicação no Diário Oficial da União., fechasAspas = false), Paragraph(Art. 5º Ficam revogados a Instrução Normativa RFB nº 734, de 2 de maio de 2007, os §§ 7º a 10 do art. 383 e os arts. 405 a 442 da Instrução Normativa RFB nº 971, de 13 novembro de 2009., fechasAspas = false), Paragraph(CARLOS ALBERTO FREITAS BARRETO, fechasAspas = false), Paragraph(ANEXO XIV, fechasAspas = false), Paragraph(ANEXO XV, fechasAspas = false), Paragraph(ANEXO XVI, fechasAspas = false), Paragraph(ANEXO XVII, fechasAspas = false))'

