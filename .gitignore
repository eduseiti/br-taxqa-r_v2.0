.venv/
__pycache__/
.pytest_cache/

# ~130 MB, above GitHub's 100 MB limit: the gzipped copy chunks_all.csv.gz is versioned instead
segmented/chunks_all.csv

.env

# Embedding outputs: vectors (~1 GB per model) are released on the HF Hub, not in git. Only the
# small provenance files are versioned (plan §4.2).
embeddings/**
!embeddings/**/
!embeddings/costs.csv
!embeddings/**/manifest.json
!embeddings/**/parity.json
!embeddings/**/check.json
!embeddings/**/endpoint_meter.jsonl

# RAG runs: rankings, per-question tables and contexts are released on the HF Hub, not in git. Only
# provenance and small result files are versioned (RAG plan §5).
runs/**
!runs/**/
!runs/**/manifest.json
!runs/**/metrics.csv
!runs/**/comparisons.csv
!runs/**/reachability.csv
!runs/**/report.md
!runs/costs.csv
.~lock.*

# Nuggets: raw API responses (cache/) are backed up on a private HF dataset repo and released with
# the frozen nuggets, not in git; input/ is regenerated from dataset/questions.jsonl (SHA-256 in
# sample.json). Docs: 20261012_154616_nuggetization_preview_open_items_resolution.md §3.
nuggets/**/cache/
nuggets/**/input/

# Batch jobs: inputs and full requests are large and regenerable; the small job records are versioned
nuggets/**/batches/*.jsonl
